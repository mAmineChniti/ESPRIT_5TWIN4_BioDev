APP_NAME=NutriTrace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Optional: set this to your machine's LAN address when testing certificate
# QR codes from a phone on the same Wi-Fi. Leave it unset otherwise.
# LAN_IP=192.168.1.10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nutritrace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -------------------------------------------------------------------------
# Generative AI
# -------------------------------------------------------------------------
# Set AI_KEY to enable Groq (free tier, no card required).
# Get your key at: https://console.groq.com/keys
#
# Without a key the pages still load and state plainly that the detector could
# not run. Nothing is ever presented as a clean bill of health it did not give.
# AI_BASE_URL is optional: leave it unset to use the default Groq endpoint.
AI_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=
AI_TIMEOUT=25

# -------------------------------------------------------------------------
# Visitor location for the origin map
# -------------------------------------------------------------------------
# The map draws a line from the visitor to where a product came from. This
# lookup is the server's half of it, and it is what lets the distance in the
# copy render without JavaScript. It sends the request IP to a third party.
#
# Set GEOIP_ENABLED=false to keep visitor IPs on the server. The map then falls
# back to the browser's own location, and if that is declined it says it could
# not work out where the reader is rather than guessing.
GEOIP_ENABLED=true
GEOIP_ENDPOINT=https://ipwho.is
GEOIP_TIMEOUT=3
GEOIP_CACHE_TTL=86400

# Only needed when this app sits behind a proxy (nginx, Cloudflare, a load
# balancer): it names the proxies whose X-Forwarded-For should be believed, so
# the origin map places the visitor rather than the proxy. Left empty, nothing
# is trusted. Use "*" only on a network where that is safe.
TRUSTED_PROXIES=
